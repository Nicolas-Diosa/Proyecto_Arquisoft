# ===== Copiar a .env y completar. NUNCA subir .env a git =====

# --- Bases de datos ---
POSTGRES_USER=buffit
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB_USUARIOS=usuarios
POSTGRES_DB_PEDIDOS=pedidos

# --- AuthService ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_HOURS=8
ALLOWED_GOOGLE_DOMAIN=unal.edu.co
STAFF_DOMAIN=comedores.buffit.test
ADMIN_DOMAIN=admin.buffit.test
CORS_ORIGINS=http://localhost:3000
# En desarrollo con el mock: http://localhost:5001. Con el gateway real: http://api-gateway:8000
GATEWAY_URL=http://localhost:5001

# --- Gestor de inventario ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=buffit_inventario
INVENTORY_PORT=5003
GRPC_PORT=50051
# Opcional: si se define, el Gestor habla con la capa GraphQL por HTTP en vez de en el mismo proceso
# GRAPHQL_URL=http://localhost:5103/graphql
